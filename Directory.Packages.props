<Project>

  <!-- the version of each package used by any project, so a mod and its tests can't drift apart -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- the JSON library SMAPI uses to send mod messages -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <PackageVersion Include="SharpCompress" Version="0.48.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
